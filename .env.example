DOCKFIN_ENV=development
DOCKFIN_HTTP_ADDR=:8000
DOCKFIN_DATABASE_URL=postgres://dockfin:dockfin@localhost:5432/dockfin?sslmode=disable
DOCKFIN_MASTER_KEY=change-me-to-a-32-byte-secret-key!!
DOCKFIN_CORS_ORIGINS=http://localhost:5173
DOCKFIN_PUBLIC_URL=http://localhost:8000
DOCKFIN_PUBLIC_IP=
DOCKFIN_DATA_DIR=./data
DOCKFIN_TEMPLATES_DIR=./templates/compose
DOCKFIN_WEB_DIR=
DOCKFIN_COOKIE_SECURE=0
DOCKFIN_TRUST_PROXY=0
DOCKFIN_BOOTSTRAP_SELF=1
DOCKFIN_ALLOW_UNSIGNED_WEBHOOKS=0
DOCKFIN_TRAEFIK_IMAGE=traefik:v3.6
DOCKFIN_ACME_EMAIL=admin@sslip.io
DOCKFIN_CADDY_IMAGE=lucaslorentz/caddy-docker-proxy:2.9-alpine
