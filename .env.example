GOOLIFY_ENV=development
GOOLIFY_HTTP_ADDR=:8080
GOOLIFY_DATABASE_URL=postgres://goolify:goolify@localhost:5432/goolify?sslmode=disable
GOOLIFY_MASTER_KEY=change-me-to-a-32-byte-secret-key!!
GOOLIFY_CORS_ORIGINS=http://localhost:5173
GOOLIFY_PUBLIC_URL=http://localhost:8080
GOOLIFY_DATA_DIR=./data
GOOLIFY_TRAEFIK_IMAGE=traefik:v3.6
GOOLIFY_ACME_EMAIL=admin@sslip.io
GOOLIFY_CADDY_IMAGE=lucaslorentz/caddy-docker-proxy:2.9-alpine
