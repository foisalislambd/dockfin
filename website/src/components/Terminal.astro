---
interface Props {
  title: string;
  command: string;
  label?: string;
}

const { title, command, label = "Copy command" } = Astro.props;
---

<div class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-[#0c121c] text-left shadow-[0_20px_50px_rgba(7,11,18,0.12)]">
  <div class="flex min-h-12 items-center gap-3 border-b border-white/10 px-3 py-2 sm:px-4">
    <span class="inline-flex gap-1.5" aria-hidden="true">
      <i class="block h-2.5 w-2.5 rounded-full bg-white/20"></i>
      <i class="block h-2.5 w-2.5 rounded-full bg-white/20"></i>
      <i class="block h-2.5 w-2.5 rounded-full bg-white/35"></i>
    </span>
    <span class="font-mono text-xs text-white/55">{title}</span>
    <button
      class="ml-auto inline-flex min-h-11 items-center rounded-lg bg-white px-3.5 text-sm font-medium text-[#0d1b2a] transition-colors hover:bg-white/90"
      type="button"
      aria-label={label}
      data-copy={command}
    >
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre class="m-0 overflow-x-auto px-4 py-4 font-mono text-[0.84rem] leading-relaxed text-[#e7eef6] sm:px-5"><code><slot /></code></pre>
</div>
