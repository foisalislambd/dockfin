---
import Base from "../layouts/Base.astro";

const title = "Page not found — Dockfin";
const description = "That page is not on the Dockfin site.";
---

<Base title={title} description={description} noindex={true}>
  <main id="content" class="mx-auto w-[min(1120px,calc(100%-2.5rem))] py-24">
    <p class="text-sm font-medium text-brand">404</p>
    <h1 class="mt-3 max-w-xl text-4xl font-semibold tracking-tight sm:text-5xl">That page is not here.</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">The install command and the rest of the site are on the home page.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="inline-flex min-h-11 items-center rounded-full bg-brand px-4 text-sm font-medium text-brand-fg no-underline hover:opacity-90" href="/">Back to Dockfin</a>
      <a class="inline-flex min-h-11 items-center rounded-full border border-line bg-surface px-4 text-sm font-medium text-ink no-underline" href="https://github.com/foisalislambd/dockfin">Star on GitHub</a>
    </div>
  </main>
</Base>
