---
import Base from "../layouts/Base.astro";

const title = "Page not found — Dockfin";
const description = "That page is not on the Dockfin site.";
---

<Base title={title} description={description} noindex={true}>
  <main id="content" class="mx-auto w-[min(1120px,calc(100%-40px))] py-16">
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.16em] text-teal">404</p>
    <h1 class="font-serif text-[clamp(2.2rem,5vw,4rem)] font-normal leading-none tracking-tight">That page is not here.</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">The install command and the rest of the site are on the home page.</p>
    <div class="mt-6 flex flex-wrap gap-2.5">
      <a class="inline-flex min-h-11 items-center rounded-full bg-teal px-4 font-semibold text-[#042228] no-underline hover:bg-[#67f0e2] hover:text-[#042228]" href="/">Back to Dockfin</a>
      <a class="inline-flex min-h-11 items-center rounded-full bg-ink px-4 font-semibold text-navy no-underline hover:bg-white hover:text-navy" href="https://github.com/foisalislambd/dockfin">Star on GitHub</a>
    </div>
  </main>
</Base>
