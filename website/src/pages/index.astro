---
import { Image } from "astro:assets";
import hero from "../assets/hero.jpg";
import FeatureIcon from "../components/FeatureIcon.astro";
import StarIcon from "../components/StarIcon.astro";
import Terminal from "../components/Terminal.astro";
import Base from "../layouts/Base.astro";

const title = "Dockfin — self-hosted open-source alternative to Heroku and Vercel";
const description =
  "Self-hosted, MIT-licensed alternative to Heroku and Vercel. One Docker image deploys apps, databases, and one-click services to your own servers over SSH.";
const installCommand =
  "curl -fsSL https://raw.githubusercontent.com/foisalislambd/dockfin/main/scripts/install.sh | sudo bash";
const updateCommand = "cd /data/dockfin && sudo docker compose pull && sudo docker compose up -d";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Dockfin",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://opensource.org/licenses/MIT",
  codeRepository: "https://github.com/foisalislambd/dockfin",
  url: "https://dockfin.foisal.org/",
  description,
  image: "https://dockfin.foisal.org/og.jpg",
};

const shell = "mx-auto w-[min(1120px,calc(100%-2.5rem))]";
const card =
  "rounded-2xl border border-line bg-surface p-6 motion-safe:transition motion-safe:duration-200 motion-safe:hover:-translate-y-0.5 motion-safe:hover:border-brand/40";
const primary =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-brand px-4 text-sm font-medium text-brand-fg no-underline transition-opacity hover:opacity-90";
const secondary =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-line bg-surface px-4 text-sm font-medium text-ink no-underline transition-colors hover:border-brand/40";
const h2 = "text-3xl font-semibold tracking-tight text-balance sm:text-4xl";
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main id="content">
    <section class="relative overflow-hidden pb-8 pt-16 sm:pt-24" id="top">
      <div class="pointer-events-none absolute inset-x-0 -top-24 h-[420px] bg-[radial-gradient(ellipse_at_top,var(--glow),transparent_62%)]" aria-hidden="true"></div>
      <div class={shell}>
        <p class="text-sm font-medium text-brand">Self-hosted PaaS · Open source · MIT</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-[1.08]">
          You already pay for a VPS. Why pay a platform to deploy onto someone else’s servers?
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
          Heroku and Vercel are good at what they do. They are also a second bill, on computers you do not control. Dockfin is the panel you run yourself: one Docker image, a Go API and a React dashboard, deploying apps, databases, and one-click services to the machines you already pay for. Over SSH. Your data stays on your VPS.
        </p>
        <div class="max-w-3xl">
          <Terminal title="ubuntu / debian" command={installCommand} label="Copy install command">
            <span class="text-white/45">$ </span>curl -fsSL https://raw.githubusercontent.com/<wbr />foisalislambd/<wbr />dockfin/<wbr />main/<wbr />scripts/<wbr />install.sh | sudo bash
          </Terminal>
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a class={primary} href="https://github.com/foisalislambd/dockfin">
            <StarIcon />
            Star on GitHub
          </a>
          <a class={secondary} href="#features">See what it actually does</a>
        </div>
        <p class="mt-4 max-w-2xl text-sm text-faint">
          Needs an Ubuntu or Debian VPS with a public IP. Then open <code class="font-mono text-[0.85em] text-ink">http://YOUR_SERVER_IP:8000/</code> and register the first admin. Nothing is seeded for you.
        </p>
        <figure class="relative mt-14">
          <div class="pointer-events-none absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(ellipse_at_center,var(--glow),transparent_68%)]" aria-hidden="true"></div>
          <Image
            src={hero}
            alt="A laptop on a navy and teal background, showing the Dockfin dashboard with live deployment logs, healthy apps, and online servers."
            widths={[480, 768, 1120, 1280]}
            sizes="(min-width: 1160px) 1120px, calc(100vw - 40px)"
            loading="eager"
            fetchpriority="high"
            class="h-auto w-full rounded-2xl border border-line shadow-[0_24px_60px_rgba(7,11,18,0.12)]"
          />
        </figure>
      </div>
    </section>

    <section class="py-8" aria-label="What stays yours">
      <div class={`${shell} grid gap-8 border-y border-line py-10 md:grid-cols-3`}>
        <article>
          <h2 class="text-base font-semibold">The server is already yours</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Dockfin does not rent you another computer. It runs on the VPS you already pay for.</p>
        </article>
        <article>
          <h2 class="text-base font-semibold">One image, then the dashboard</h2>
          <p class="mt-2 text-sm leading-6 text-muted">
            The script pulls <code class="font-mono text-[0.85em] text-ink">ghcr.io/foisalislambd/dockfin</code>. The same image is on <a href="https://hub.docker.com/r/foisalislambd/dockfin">Docker Hub</a>. API and dashboard ship together. Postgres starts beside them. The panel listens on port 8000.
          </p>
        </article>
        <article>
          <h2 class="text-base font-semibold">SSH, not a second platform</h2>
          <p class="mt-2 text-sm leading-6 text-muted">State stays in Postgres. Deploys go out over SSH. Targets do not need a long-lived deploy agent. Ports 80 and 443 stay free for Traefik or Caddy.</p>
        </article>
      </div>
    </section>

    <section class="py-20 sm:py-28" id="features">
      <div class={shell}>
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-brand">What you feel on a bad Tuesday</p>
          <h2 class={`mt-3 ${h2}`}>The deploy, the rollback, and the pause button.</h2>
          <p class="mt-4 text-lg text-muted">A platform earns its keep the night something ships wrong. These are in the product today, not on a roadmap slide.</p>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <article class={`${card} motion-safe:[animation:rise_0.55s_ease_both]`}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="logs" /></div>
            <h3 class="text-base font-semibold">Watch the run, not a spinner</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Live deploy logs. The deployment page replays the log and streams the rest while it happens. Pull, build, migrate, health check. When it fails, you are looking at the line that failed.</p>
          </article>
          <article class={`${card} motion-safe:[animation:rise_0.55s_ease_0.05s_both]`}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="rollback" /></div>
            <h3 class="text-base font-semibold">Go back without rebuilding the past</h3>
            <p class="mt-2 text-sm leading-6 text-muted">One-click rollback. Previous images stay on the server. Roll back from the dashboard, or from <code class="font-mono text-[0.85em] text-ink">dfin</code>.</p>
          </article>
          <article class={`${card} motion-safe:[animation:rise_0.55s_ease_0.1s_both]`}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="freeze" /></div>
            <h3 class="text-base font-semibold">Pause deploys when you mean it</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Per-environment deploy freeze. Dashboard, webhooks, previews, MCP, and rollback wait. What is already running stays up. Owners and admins can override one manual deploy. <code class="font-mono text-[0.85em] text-ink">dfin freeze</code> and <code class="font-mono text-[0.85em] text-ink">dfin unfreeze</code> do it from a shell.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="templates" /></div>
            <h3 class="text-base font-semibold">Hundreds of one-click templates</h3>
            <p class="mt-2 text-sm leading-6 text-muted">The catalog in the repo is about 360 Compose services. Point one at a server and deploy it, or paste your own Compose file.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="cli" /></div>
            <h3 class="text-base font-semibold">A CLI for the same control plane</h3>
            <p class="mt-2 text-sm leading-6 text-muted"><code class="font-mono text-[0.85em] text-ink">dfin --json projects list</code><br /><code class="font-mono text-[0.85em] text-ink">dfin logs &lt;deployment&gt; --follow</code></p>
            <p class="mt-2 text-sm leading-6 text-muted">Env vars, freeze, deploy, overview. Commands exit 0 on HTTP success and 1 otherwise.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="api" /></div>
            <h3 class="text-base font-semibold">The API is the router</h3>
            <p class="mt-2 text-sm leading-6 text-muted">OpenAPI 3.1 is generated from the live router at <code class="font-mono text-[0.85em] text-ink">/openapi.json</code>, with an HTML index at <code class="font-mono text-[0.85em] text-ink">/api/docs</code>. The spec is in the repo, so you can read it before you install.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="audit" /></div>
            <h3 class="text-base font-semibold">A memory for owners and admins</h3>
            <p class="mt-2 text-sm leading-6 text-muted">The audit log covers auth, deploys, rollbacks, freezes, settings, members, and role changes. Filter and page them. Retention defaults to 90 days.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="shield" /></div>
            <h3 class="text-base font-semibold">TOTP, with recovery codes</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Turn 2FA on, keep the codes, and the next login asks for the second factor. Turn it off when you mean to.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="users" /></div>
            <h3 class="text-base font-semibold">Owner, admin, member</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Signup creates a personal team. Shared teams have invitations and API tokens. Those roles decide who can read the audit log and override a freeze.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-20 sm:py-28" id="deploy">
      <div class={shell}>
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-brand">On the server</p>
          <h2 class={`mt-3 ${h2}`}>Apps, databases, and the services you did not want to hand-write.</h2>
          <p class="mt-4 text-lg text-muted">Git webhooks and env vars are part of the same deploy, not a side project.</p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-2">
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="box" /></div>
            <h3 class="text-base font-semibold">Five ways in</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Dockerfile, Compose, a container image, Railpack, or a static site. Webhooks from GitHub, GitLab, Gitea, and Bitbucket. Env vars resolve when the deploy runs.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="database" /></div>
            <h3 class="text-base font-semibold">Postgres, MySQL, MongoDB, Redis, and more</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Nine engines, including SQLite as a mounted file. Start and stop them over SSH. Backups can go to S3.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="layers" /></div>
            <h3 class="text-base font-semibold">Hundreds of one-click templates</h3>
            <p class="mt-2 text-sm leading-6 text-muted">About 360 in the repository, plus a custom Compose file when you already know what you want running.</p>
          </article>
          <article class={card}>
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand"><FeatureIcon name="lock" /></div>
            <h3 class="text-base font-semibold">Encrypted where it should be</h3>
            <p class="mt-2 text-sm leading-6 text-muted">SSH private keys and env values are encrypted in Postgres. The master key is AES-256-GCM. Passwords are argon2id. Webhook signatures are required when a secret is set.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-20 sm:py-28" id="how">
      <div class={shell}>
        <p class="text-sm font-medium text-brand">From a fresh VPS to a deploy</p>
        <h2 class={`mt-3 max-w-2xl ${h2}`}>Three steps. Then it is your panel.</h2>
        <ol class="mt-12 grid list-none gap-4 p-0 lg:grid-cols-3">
          <li class={card}>
            <p class="font-mono text-sm text-brand">01</p>
            <h3 class="mt-3 text-base font-semibold">Run the install</h3>
            <p class="mt-2 text-sm leading-6 text-muted">One command. It installs Docker if it is missing, generates secrets, and starts Postgres and Dockfin. Everything important lands in <code class="font-mono text-[0.85em] text-ink">/data/dockfin</code>.</p>
          </li>
          <li class={card}>
            <p class="font-mono text-sm text-brand">02</p>
            <h3 class="mt-3 text-base font-semibold">Register, once</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Open port 8000 and create the admin account. That VPS is added as a server for you. Create a project. Add other machines later, still over SSH.</p>
          </li>
          <li class={card}>
            <p class="font-mono text-sm text-brand">03</p>
            <h3 class="mt-3 text-base font-semibold">Deploy</h3>
            <p class="mt-2 text-sm leading-6 text-muted">The control plane keeps the desired state. Workers build and restart containers on the server. Logs stream back to the dashboard.</p>
          </li>
        </ol>
        <p class="mt-8 text-sm text-faint">The deploy itself runs prepare, fetch, build, run, health, then finalize.</p>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
          <span>Update later</span>
          <code class="font-mono text-[0.85em] text-ink">{updateCommand}</code>
          <button class="min-h-11 bg-transparent p-0 text-sm font-medium text-brand underline underline-offset-4" type="button" data-copy={updateCommand} aria-label="Copy update command">
            <span data-copy-label>Copy</span>
          </button>
        </p>
      </div>
    </section>

    <section class="border-t border-line py-20 sm:py-28" id="compare">
      <div class={shell}>
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-brand">An honest fork in the road</p>
          <h2 class={`mt-3 ${h2}`}>Why not Coolify or Dokku.</h2>
          <p class="mt-4 text-lg text-muted">They are good tools. They are not this tool. If a landing page has to flatten that, it is selling you something.</p>
        </div>
        <div class="mt-12 grid gap-4 lg:grid-cols-2">
          <article class={card}>
            <h3 class="text-xl font-semibold tracking-tight">Coolify</h3>
            <p class="mt-3 text-sm leading-6 text-muted">This is the closer cousin, and it has a head start. Same job in your head: your servers, SSH, Traefik or Caddy, build packs, a catalog of services. Dockfin follows that operator model and rebuilds the control plane in Go, with an API-first React dashboard, an OpenAPI spec generated from the live router, and the <code class="font-mono text-[0.85em] text-ink">dfin</code> CLI.</p>
            <p class="mt-3 text-sm leading-6 text-muted">If you want the project that has already met more strange servers in the wild, use Coolify. There is no user count on this page to pretend otherwise. Choose Dockfin when you want that shape as one MIT-licensed Go image, and a codebase you can still influence.</p>
          </article>
          <article class={card}>
            <h3 class="text-xl font-semibold tracking-tight">Dokku</h3>
            <p class="mt-3 text-sm leading-6 text-muted">Dokku is a git-push PaaS. It is small, it is sharp, and the interface is <code class="font-mono text-[0.85em] text-ink">git push</code>. That is the right answer when one server and a buildpack-style deploy is the whole story.</p>
            <p class="mt-3 text-sm leading-6 text-muted">Dockfin is the panel in front of one or many Docker hosts: projects, environments, live logs, rollback, a deploy freeze, databases, and hundreds of one-click templates. If you do not want a dashboard, do not install one.</p>
          </article>
        </div>
        <aside class={`${card} mt-4`}>
          <h3 class="text-base font-semibold">Choose Dockfin when</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-muted">
            <li>You already pay for the VPS, and you want the panel on it.</li>
            <li>You want apps, databases, and service templates from one place, over SSH.</li>
            <li>You want a CLI and an OpenAPI document, not only a UI.</li>
            <li>You would rather help shape the tool than wait for someone else’s hosted plan.</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="border-t border-line py-20 sm:py-28" id="early">
      <div class={shell}>
        <div class="max-w-3xl rounded-3xl border border-line bg-surface p-8 sm:p-10">
          <p class="text-sm font-medium text-brand">It is early. Help shape it.</p>
          <h2 class={`mt-3 ${h2}`}>No logo wall. That would be a story, not a fact.</h2>
          <p class="mt-5 text-lg text-muted">This page will not invent a user count, a logo wall, or a customer quote. If those show up later, they will be real.</p>
          <p class="mt-4 text-muted">What exists today is a production install, a dashboard, and a public checklist: live logs, rollback, deploy freeze, hundreds of one-click templates, <code class="font-mono text-[0.85em] text-ink">dfin</code>, OpenAPI, an audit log, 2FA, and team roles. It is a lot of product for a project you can still bend. It is not a hosted service with a status page and a support contract. You run the image. You keep the disk. When something is rough, GitHub is the queue.</p>
          <p class="mt-4 text-muted">
            Star the repository if you want the work where you will see it. Open a pull request if a gap is one you can close. <a href="https://github.com/foisalislambd/dockfin/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a> is the door. The license is MIT, which includes the part where you can fork it and never ask. Security reports stay private — see <a href="https://github.com/foisalislambd/dockfin/blob/main/SECURITY.md">SECURITY.md</a>.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a class={primary} href="https://github.com/foisalislambd/dockfin">Star on GitHub</a>
            <a class={secondary} href="https://github.com/foisalislambd/dockfin/issues">Open an issue</a>
            <a class={secondary} href="https://github.com/foisalislambd/dockfin/blob/main/docs/FEATURES.md">Read the feature checklist</a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-20 sm:py-28" id="install">
      <div class={shell}>
        <div class="relative overflow-hidden rounded-3xl border border-line bg-surface px-6 py-10 sm:px-10">
          <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-[radial-gradient(circle,var(--glow),transparent_70%)]" aria-hidden="true"></div>
          <p class="text-sm font-medium text-brand">Install</p>
          <h2 class={`mt-3 max-w-2xl ${h2}`}>Put the panel on the server you already have.</h2>
          <p class="mt-4 max-w-2xl text-lg text-muted">Ubuntu or Debian, a public IP, and one command. The script pulls the image from GitHub Container Registry, installs Docker if you do not have it, and leaves 80 and 443 alone for the proxy.</p>
          <div class="max-w-3xl">
            <Terminal title="install.sh" command={installCommand} label="Copy install command">
              <span class="text-white/45">$ </span>curl -fsSL https://raw.githubusercontent.com/<wbr />foisalislambd/<wbr />dockfin/<wbr />main/<wbr />scripts/<wbr />install.sh | sudo bash
            </Terminal>
          </div>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a class={primary} href="https://github.com/foisalislambd/dockfin">Star on GitHub</a>
            <a class={secondary} href="https://github.com/foisalislambd/dockfin#install-on-a-production-server">Install notes in the README</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
