# syntax=docker/dockerfile:1
# Single image: API + Vite dashboard (served by goolify on :8000)

FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build \
  -ldflags="-s -w -X github.com/goolify/goolify/internal/version.Version=${VERSION}" \
  -o /out/goolify ./cmd/goolify

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/goolify /usr/local/bin/goolify
COPY --from=web /web/dist /app/web
COPY templates/compose /app/templates
ENV GOOLIFY_TEMPLATES_DIR=/app/templates \
    GOOLIFY_WEB_DIR=/app/web \
    GOOLIFY_DATA_DIR=/data \
    GOOLIFY_HTTP_ADDR=:8000
EXPOSE 8000
VOLUME ["/data"]
ENTRYPOINT ["goolify"]
CMD ["serve"]
