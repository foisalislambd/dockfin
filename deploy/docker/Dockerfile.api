# syntax=docker/dockerfile:1
# Single image: API + Vite dashboard (served by dockfin on :8000)

FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build \
  -ldflags="-s -w -X github.com/dockfin/dockfin/internal/version.Version=${VERSION}" \
  -o /out/dockfin ./cmd/dockfin

FROM alpine:3.21
# git + openssh: compose auto-detect / local git operations inside the API container
RUN apk add --no-cache ca-certificates tzdata git openssh-client
WORKDIR /app
COPY --from=build /out/dockfin /usr/local/bin/dockfin
COPY --from=web /web/dist /app/web
COPY templates/compose /app/templates
ENV DOCKFIN_TEMPLATES_DIR=/app/templates \
    DOCKFIN_WEB_DIR=/app/web \
    DOCKFIN_DATA_DIR=/data \
    DOCKFIN_HTTP_ADDR=:8000
EXPOSE 8000
VOLUME ["/data"]
ENTRYPOINT ["dockfin"]
CMD ["serve"]
