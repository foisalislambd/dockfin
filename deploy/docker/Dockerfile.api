FROM golang:1.23-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/goolify ./cmd/goolify

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/goolify /usr/local/bin/goolify
COPY migrations /app/migrations
ENV GOOLIFY_MIGRATIONS_DIR=/app/migrations
EXPOSE 8080
ENTRYPOINT ["goolify"]
CMD ["serve"]
